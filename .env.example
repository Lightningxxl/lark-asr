COMPOSE_PROJECT_NAME=lark-asr

# Example host paths. These are bind-mounted into containers.
LARK_CLI_CONFIG_DIR=/path/to/.config/lark-cli
LARK_CLI_DATA_DIR=/path/to/.local/share
CODEX_HOME=/path/to/.codex
SSH_DIR=/path/to/.ssh
KNOWLEDGEBASE_DIR=/path/to/projects/knowledgebase

# Mount the directory that contains whisper-large-v3-ct2-float16.
# Reuse an existing CT2 model to avoid redownloading it.
MODELS_DIR=/path/to/models

WORKER_INTERVAL=20

# Build-time pins.
LARK_ASR_APP_IMAGE=lark-asr/app:local
LARK_ASR_ASR_IMAGE=lark-asr/asr:local
APP_BASE_IMAGE=node:22-bookworm-slim
ASR_BASE_IMAGE=node:22-bookworm-slim
LARK_CLI_VERSION=1.0.14
CODEX_CLI_VERSION=0.125.0

# Build mirrors. Defaults are chosen for restricted networks.
DEBIAN_APT_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian
DEBIAN_SECURITY_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian-security
NPM_REGISTRY=https://registry.npmjs.org

# Optional runtime DNS for Docker services. Set this when Docker DNS forwarding to the host resolver is flaky.
LARK_ASR_DNS_1=1.1.1.1
LARK_ASR_DNS_2=8.8.8.8

# Optional worker egress proxy for Codex/API traffic. Lark CLI keeps its own
# direct-connect behavior through LARK_CLI_NO_PROXY=1.
LARK_ASR_HTTP_PROXY=
LARK_ASR_HTTPS_PROXY=
LARK_ASR_ALL_PROXY=
LARK_ASR_NO_PROXY=localhost,127.0.0.1
